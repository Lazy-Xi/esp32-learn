menu "WiFi and 4 Relays"

config RELAY_WIFI_SSID
    string "WiFi SSID"
    default "your-wifi-name"

config RELAY_WIFI_PASSWORD
    string "WiFi password (WPA2/WPA3 Personal)"
    default "change-me-123"

config RELAY_ACTIVE_LOW
    bool "Relay inputs are active-low"
    default y
    help
        Enable for LOW=ON modules. Disable for HIGH=ON modules.
        Configure all four module channels for the same polarity.

config RELAY_HTTP_ENABLED
    bool "Enable relay HTTP control page and API"
    default y
    help
        Serve the control page on port 80 after WiFi gets an IP address.
        Devices on the network can control relays without authentication.

config RELAY_RUN_DEMO
    bool "Run automatic relay sequence after WiFi connects"
    depends on !RELAY_HTTP_ENABLED
    default n
    help
        Energizes channels 1, 2, 3, 4 one at a time for 2 seconds.
        Use only with unloaded contacts or safe low-voltage test loads.

endmenu
