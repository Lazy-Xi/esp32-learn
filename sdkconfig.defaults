CONFIG_IDF_TARGET="esp32c5"

# ESP32-C5HF4 rev v1.0: 4 MB embedded flash, 48 MHz crystal.
CONFIG_ESP32C5_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# ESP-IDF detects the C5 crystal frequency from the hardware configuration.
CONFIG_XTAL_FREQ_AUTO=y
CONFIG_SPIRAM=n

# The board is connected through its built-in USB Serial/JTAG controller.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
